<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays off. The app trusts only the system CA store: node,
     subscription and update traffic must use publicly trusted TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
